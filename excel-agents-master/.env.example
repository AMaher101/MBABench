# =============================================================================
# REQUIRED — without these, the browser cannot log into Excel Online and
# every task will fail at the navigation step.
# =============================================================================

# Microsoft 365 / OneDrive account credentials. Used by the browser to log
# into office.com and access Excel Online.
ONEDRIVE_EMAIL=your_email@example.com
ONEDRIVE_PASSWORD=your_password

# =============================================================================
# OPTIONAL — only needed if your TabAI add-in uses a separate login from the
# OneDrive account above (most users do not need this).
# =============================================================================
# TABAI_EMAIL=your_email@example.com
# TABAI_PASSWORD=your_password
